# NHooks — recebedor de webhooks self-hosted (Go)

# --- Servidor ---
LISTEN_ADDR=:8080
PUBLIC_URL=http://localhost:8080

# --- Banco (DB_DRIVER=sqlite | postgres) ---
DB_DRIVER=sqlite
DB_PATH=nhooks.db
# DB_DRIVER=postgres
# DB_DSN=host=127.0.0.1 port=5432 dbname=nhooks user=nhooks password=nhooks sslmode=disable
# DB_MAX_OPEN_CONNS=1

# --- Identidade visual ---
BRAND_NAME=NHooks
BRAND_COLOR=#12948e
BRAND_COLOR_DARK=#0d7a75
BRAND_COLOR_DIM=#6dcfc9
BRAND_LOGO_URL=
APP_TITLE=NHooks
APP_DESCRIPTION="Gere URLs amigáveis para receber e testar eventos de webhook em tempo real."
APP_THEME=dark
COMPANY_URL=https://notreve.com.br

# --- Rotas ---
APP_INGEST_ROUTE=hook
APP_POLLING_MS=3000
DASHBOARD_EVENTS_LIMIT=200

# --- Retenção e limites ---
EVENT_RETENTION_HOURS=24
USER_STORAGE_LIMIT_ENABLED=true
USER_STORAGE_LIMIT=100MB
USER_EVENTS_LIMIT_ENABLED=true
USER_EVENTS_LIMIT=10000

# --- Criptografia de eventos em repouso (chave forte em produção) ---
EVENT_ENCRYPTION_ENABLED=true
EVENT_ENCRYPTION_KEY=change-this-secret-key

# --- Redis (opcional — modo escala) ---
REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ (opcional — processamento assíncrono) ---
AMQP_ENABLED=false
AMQP_URL=amqp://guest:guest@127.0.0.1:5672/
AMQP_QUEUE=nhooks_async

# --- IA (opcional, bring-your-own-key) ---
# A IA usa a chave do CLIENTE (colada no painel, enviada server-side na chamada).
# O servidor pode ter uma chave padrão (AI_API_KEY) usada quando o cliente não informa.
AI_ENABLED=true
AI_API_KEY=
AI_MODEL=notreve-v1-lite
AI_BASE_URL=https://api.ia.notreve.com.br
AI_KEYS_URL=https://ia.notreve.com.br
AI_APP_NAME=IA

# --- Admin interno (/admin) — chave opcional ---
SYSTEM_ADMIN_KEY=
